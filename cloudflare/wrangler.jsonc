{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "admission-collector-offload",
  "main": "src/index.js",
  "compatibility_date": "2026-08-28",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "admission-collector-db",
      "database_id": "ed2a4417-c427-415b-8414-6b1f06c7194d"
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "queues": {
    "producers": [
      {
        "binding": "INGEST_QUEUE",
        "queue": "admission-collector-ingest"
      }
    ],
    "consumers": [
      {
        "queue": "admission-collector-ingest",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "admission-collector-ingest-dlq"
      }
    ]
  }
}
